# Keep shell scripts and config LF on every platform — a CRLF .sh breaks bash
# on Linux/macOS ($'\r': command not found) and inside Git Bash hooks.
* text=auto
*.sh   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.js   text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
*.ps1  text eol=crlf
